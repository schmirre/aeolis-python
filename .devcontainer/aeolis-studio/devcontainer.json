{
  "name": "AeoLiS Studio",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "hostRequirements": {
    "cpus": 2
  },
  "postCreateCommand": "bash tools/aeolis_studio/setup.sh && bash tools/aeolis_studio/install.sh",
  "postAttachCommand": {
    "studio": "bash tools/aeolis_studio/start.sh"
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "AeoLiS Studio",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "tools/aeolis_studio/README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
